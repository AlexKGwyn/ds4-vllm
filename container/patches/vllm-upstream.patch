+def _canonicalize_topk_indices_(indices: torch.Tensor) -> None:
+    """Put a top-k set in a deterministic, attention-safe order in place.
+
+    The libtorch ``top_k_per_row_*`` kernels use atomics while collecting their
+    candidates. Even when the selected set is identical, its output order can
+    vary between launches. Sparse attention consumes that order directly, so
+    finite-precision online-softmax accumulation turns the permutation into a
+    different hidden state. Sort valid local indices ascending and keep ``-1``
+    padding at the tail to make repeated forwards reproducible.
+    """
+    sentinel = torch.iinfo(indices.dtype).max
+    sortable = torch.where(indices >= 0, indices, sentinel)
+    ordered = torch.sort(sortable, dim=-1, stable=True).values
+    indices.copy_(torch.where(ordered == sentinel, -1, ordered))
