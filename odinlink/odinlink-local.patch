+ * currently out with a reader is released by odl_tb5_rx_msg_free() instead --
+ * stream teardown drains rx_queue before calling this. */
+static void odl_tb5_asm_pool_destroy(struct odl_tb5_stream *stream)
+{
+	unsigned int i;
+
+	if (!stream->rx_asm_pool)
+		return;
+	for (i = 0; i < stream->rx_asm_pool_n; i++)
+		kvfree(stream->rx_asm_pool[i]);
+	kfree(stream->rx_asm_pool);
+	stream->rx_asm_pool = NULL;
+	stream->rx_asm_pool_n = 0;
+	stream->rx_asm_pool_cap = 0;
+}
+
+/* Release one received message. ->data is either a pool buffer handed over
+ * whole or a kmalloc'd copy from the fallback path, and the two need different
+ * allocators -- which is what ->data_from_pool records. */
+static void odl_tb5_rx_msg_free(struct odl_tb5_stream *stream,
+				struct odl_tb5_rx_msg *rxm)
+{
+	if (!rxm)
+		return;
+	if (rxm->data) {
+		if (rxm->data_from_pool)
+			odl_tb5_asm_pool_put(stream, rxm->data);
+		else
+			kfree(rxm->data);
+	}
+	kfree(rxm);
+}
