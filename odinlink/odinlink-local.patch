diff --git a/driver/odl_tb5_proto.c b/driver/odl_tb5_proto.c
index 62617b8..668141a 100644
--- a/driver/odl_tb5_proto.c
+++ b/driver/odl_tb5_proto.c
@@ -158,6 +158,25 @@ static int odl_tb5_proto_handle_packet(const void *buf, size_t size,
 			dev->transport->local_tx_hopid(dev));
 
 		mutex_lock(&dev->state_lock);
+		if (dev->state == ODL_TB5_STATE_CONNECTED) {
+			/* Peer re-logged-in while our DMA verify is running.
+			 * Tearing down here aborts our verify, and with both
+			 * sides doing that the restarts phase-lock and never
+			 * converge.  Hop/hopid assignment is deterministic,
+			 * so instead: adopt the peer's (identical) hopid,
+			 * answer with our own LOGIN so the restarted peer can
+			 * complete its handshake and join verify, and let our
+			 * verify keep running.  If addressing truly changed,
+			 * verify times out and its restart path recovers. */
+			pr_info("odl_tb5: peer re-login during verify — "
+				"continuing verify, re-sending login\n");
+			dev->remote_tx_hopid = remote_tx_hopid;
+			dev->login_received = true;
+			mutex_unlock(&dev->state_lock);
+			mutex_unlock(&odl_tb5_devices_lock);
+			odl_tb5_proto_send_login(dev);
+			return 1;
+		}
 		if (dev->state != ODL_TB5_STATE_HANDSHAKE) {
 			pr_info("odl_tb5: peer restarted (our state=%d), "
 				"scheduling restart\n", dev->state);
@@ -586,6 +605,17 @@ static void odl_tb5_verify_work_fn(struct work_struct *work)
 		       "Peer never answered the DMA ping.\n",
 		       attempt, dev->login_sent, dev->login_received,
 		       dev->remote_tx_hopid, tx_info.hop, rx_info.hop);
+		/* Parking in CONNECTED here wedges the link until a module
+		 * reload: the peer that DID reach READY has stale paths and
+		 * silently drops our traffic, and nothing ever retries.  A
+		 * full connection restart resends LOGIN, which kicks the
+		 * READY-side peer through its own restart, so both ends
+		 * re-handshake fresh and re-verify together. */
+		if (!atomic_read(&dev->removing)) {
+			pr_info("odl_tb5: scheduling connection restart "
+				"after failed DMA verify\n");
+			schedule_work(&dev->restart_work);
+		}
 		goto out_reset;
 	}
 
