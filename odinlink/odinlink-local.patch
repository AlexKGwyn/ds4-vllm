+static void *odl_tb5_asm_pool_get(struct odl_tb5_stream *stream)
+{
+	unsigned long flags;
+	void *buf = NULL;
+
+	spin_lock_irqsave(&stream->rx_asm_pool_lock, flags);
+	if (stream->rx_asm_pool_n)
+		buf = stream->rx_asm_pool[--stream->rx_asm_pool_n];
+	spin_unlock_irqrestore(&stream->rx_asm_pool_lock, flags);
