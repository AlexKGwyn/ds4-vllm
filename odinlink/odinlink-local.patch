+	if (!buf) {
+		atomic_inc(&stream->rx_asm_pool_empty);
+		/* Greppable, because the counter is not readable from
+		 * userspace: this is the signal that MSG_END has gone back to
+		 * copying, and so back to a large GFP_ATOMIC allocation that
+		 * can fail. Steady state should never print this. */
+		pr_warn_ratelimited("odl_tb5: stream %u rx_asm pool empty (%d) - MSG_END falling back to copy\n",
+				    stream->id,
+				    atomic_read(&stream->rx_asm_pool_empty));
+	}
+	return buf;
+}
+
+static void odl_tb5_asm_pool_put(struct odl_tb5_stream *stream, void *buf)
+{
+	unsigned long flags;
+	bool stored = false;
+
+	if (!buf)
+		return;
+
+	spin_lock_irqsave(&stream->rx_asm_pool_lock, flags);
+	if (stream->rx_asm_pool_n < stream->rx_asm_pool_cap) {
+		stream->rx_asm_pool[stream->rx_asm_pool_n++] = buf;
+		stored = true;
+	}
+	spin_unlock_irqrestore(&stream->rx_asm_pool_lock, flags);
+
+	/* Cannot happen while the pool owns a fixed number of buffers, but
+	 * leaking one would be worse than the free. */
+	if (!stored)
+		kvfree(buf);
