 #define ODL_TB5_POLL_INTERVAL_NS	(3 * 1000)   /* 3 us */
 
+/* Runtime-tunable poll interval (rx_poll_ns, default above).  Clamped so a
+ * stray 0 cannot turn the hrtimer into a hardirq spin. */
+#define ODL_TB5_POLL_INTERVAL_MIN_NS	500
+static inline u64 odl_tb5_poll_interval_ns(void)
+{
+	extern unsigned int odl_rx_poll_ns;
+
+	return max_t(u64, odl_rx_poll_ns, ODL_TB5_POLL_INTERVAL_MIN_NS);
+}
