-			   num_devices);
-	else
-		fprintf(stderr, "NCCL INFO ODL_TB5 net plugin loaded (%d device(s))\n",
-			num_devices);
+	/* Do NOT call odl_logger by hand here: ncclDebugLogger_t takes
+	 * (level, flags, file, line, fmt, ...) and the old 2-arg call made
+	 * RCCL deref the device count as a filename pointer -- instant
+	 * SIGSEGV inside ncclDebugLog when a real logger is wired in. */
+	fprintf(stderr, "NCCL INFO ODL_TB5 net plugin loaded (%d device(s); use NET/ODL_TB5, not Socket)\n",
+		num_devices);
 	if (num_devices == 0)
 		WARN("no /dev/odl_tb5_* — reporting 0 devices. "
 		     "Load odl_tb5 on both machines and wait for "
