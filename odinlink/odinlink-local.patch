 			dev->transport->local_tx_hopid(dev));
 
 		mutex_lock(&dev->state_lock);
+		if (dev->state == ODL_TB5_STATE_CONNECTED) {
+			/* Peer re-logged-in while our DMA verify is running.
+			 * Tearing down here aborts our verify, and with both
+			 * sides doing that the restarts phase-lock and never
+			 * converge.  Hop/hopid assignment is deterministic,
+			 * so instead: adopt the peer's (identical) hopid,
+			 * answer with our own LOGIN so the restarted peer can
+			 * complete its handshake and join verify, and let our
+			 * verify keep running.  If addressing truly changed,
+			 * verify times out and its restart path recovers. */
+			pr_info("odl_tb5: peer re-login during verify — "
+				"continuing verify, re-sending login\n");
+			dev->remote_tx_hopid = remote_tx_hopid;
+			dev->login_received = true;
+			mutex_unlock(&dev->state_lock);
+			mutex_unlock(&odl_tb5_devices_lock);
+			odl_tb5_proto_send_login(dev);
+			return 1;
+		}
 		if (dev->state != ODL_TB5_STATE_HANDSHAKE) {
